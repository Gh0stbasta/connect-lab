{
  "name": "amazon-connect-lab",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "amazonwebservices.aws-toolkit-vscode",
        "ms-python.python",
        "eamodio.gitlens"
      ]
    }
  },

  "remoteUser": "vscode"
}